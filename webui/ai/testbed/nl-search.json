      "input": { "phrase": "vulnerabilities actively exploited, high or critical", "target": "findings", "today": "2026-11-25",
        "vocabulary": { "projects": ["boutique"], "tools": ["osv-scanner", "trivy"], "ecosystems": ["npm"] } },
      "expect": { "mention_any": ["high", "critical"], "must_not_contain": ["SELECT"] }
    },
    {
      "id": "component-version",
      "input": { "phrase": "qui utilise lodash en version 4.17.20 ?", "target": "auto", "today": "2026-11-25",
        "vocabulary": { "projects": ["boutique"], "tools": ["trivy"], "ecosystems": ["npm", "pypi"] } },
      "expect": { "mention_any": ["lodash"], "must_not_contain": ["SELECT"] }
    },
    {
      "id": "cve-components",
      "input": { "phrase": "projects affected by CVE-2021-44228", "target": "auto", "today": "2026-11-25",
