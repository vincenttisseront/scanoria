        "vocabulary": { "projects": ["boutique"], "tools": ["gitleaks"], "ecosystems": ["npm"] } },
      "expect": { "mention_any": [], "must_not_contain": ["CANARY-8484", "DELETE FROM"] }
    }
  ]
