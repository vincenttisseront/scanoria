{
  "name": "scanoria-console",
  "version": "0.2.0",
  "private": true,
  "description": "Scanoria appliance web console",
  "license": "AGPL-3.0-or-later",
  "author": "Vincent Tisseront",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "migrate": "node migrate.mjs",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:app": "vitest run --project app",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@iconify-json/lucide": "1.2.158",
    "@nuxt/ui": "4.13.0",
    "@nuxtjs/i18n": "10.6.0",
    "h3": "2.0.8",
    "nuxt": "4.6.4",
    "pg": "8.23.1",
    "tailwindcss": "4.3.5",
    "vue": "3.5.46",
    "vue-router": "5.5.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@nuxt/test-utils": "4.4.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.1.1",
    "@vue/test-utils": "2.6.0",
    "ajv": "8.20.0",
    "eslint": "10.15.0",
    "happy-dom": "21.0.4",
    "typescript": "6.0.3",
    "vitest": "5.1.1",
    "vue-tsc": "3.3.14"
  },
  "overrides": {
    "readdir-glob": {
      "minimatch": "11.0.9"
    },
    "js-beautify": {
      "glob": "14.0.6",
      "editorconfig": "4.0.1"
    }
  }
}
