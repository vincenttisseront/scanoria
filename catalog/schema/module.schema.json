{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scanoria:schema:module:1",
  "$comment": "SPDX-License-Identifier: AGPL-3.0-or-later. Copyright (C) 2026 Vincent Tisseront. Manifeste modules/<id>/module.yaml (CLAUDE.md § 4.2, contrat 1 de la 0.2). Documentation : docs/MODULES.md. Sous-ensemble de mots-clés de scanoria/schema.py (ni $ref, ni format, ni patternProperties).",
  "title": "Manifeste de module Scanoria",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "type",
    "categories",
    "license",
    "upstream",
    "version",
    "resources",
    "requires",
    "options"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,40}$",
      "description": "Identifiant, égal au nom du dossier modules/<id>/."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fr",
        "en"
      ],
      "properties": {
        "fr": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "type": {
      "enum": [
        "scanner",
        "service",
        "feed",
        "runner"
      ]
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "quality",
          "sast",
          "secrets",
          "sca",
          "iac",
          "container",
          "sbom",
          "dast",
          "lint",
          "licenses",
          "vuln-management",
          "ci",
          "system"
        ]
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spdx",
        "url",
        "restrictions"
      ],
      "properties": {
        "spdx": {
          "type": "string",
          "pattern": "^[A-Za-z0-9.+-]+( (AND|OR|WITH) [A-Za-z0-9.+-]+)*$",
          "maxLength": 200
        },
        "url": {
          "type": "string",
          "pattern": "^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[^\\s]*)?$",
          "maxLength": 500
        },
        "restrictions": {
          "enum": [
            "none",
            "private-code-forbidden",
            "no-redistribution",
            "other"
          ]
        },
        "verified_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Date de la dernière vérification sur le dépôt amont."
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "homepage",
        "source"
      ],
      "properties": {
        "homepage": {
          "type": "string",
          "pattern": "^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[^\\s]*)?$",
          "maxLength": 500
        },
        "source": {
          "type": "string",
          "pattern": "^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[^\\s]*)?$",
          "maxLength": 500
        }
      }
    },
    "image": {
      "type": "string",
      "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+(:[0-9]{1,5})?(/[a-z0-9]+([._-]{1,2}[a-z0-9]+)*)+@sha256:[0-9a-f]{64}$",
      "maxLength": 300,
      "description": "Image épinglée par empreinte, registre explicite (pas de nom court), sans étiquette."
    },
    "image_pending": {
      "const": true,
      "description": "0.7 : image construite par la CI de Scanoria (modules/<id>/image/Containerfile, workflow tool-images.yml) et pas encore publiée. Exclusif avec image : un module en attente n'a pas d'image, catalog/build.py l'écarte de l'index, et la PR de suivi pose image (ghcr.io/vincenttisseront/scanoria-<id>@sha256:…) en retirant cette clé."
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9A-Za-z][0-9A-Za-z.+_-]{0,63}$",
      "description": "Version de l'outil (ou du format pour un feed), utilisable dans un nom de fichier."
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_ram_mb",
        "min_cpu",
        "disk_mb"
      ],
      "properties": {
        "min_ram_mb": {
          "type": "integer",
          "minimum": 16,
          "maximum": 1048576
        },
        "min_cpu": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 256
        },
        "disk_mb": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10485760
        }
      }
    },
    "hostname": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?$"
        }
      ]
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modules",
        "feeds",
        "appliance"
      ],
      "properties": {
        "modules": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,40}$"
          },
          "uniqueItems": true,
          "maxItems": 50
        },
        "feeds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,40}$"
          },
          "uniqueItems": true,
          "maxItems": 50
        },
        "appliance": {
          "type": "string",
          "pattern": "^>=[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{1,40}$"
      },
      "uniqueItems": true,
      "maxItems": 50
    },
    "needs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sysctl": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string",
                "pattern": "^[0-9 ]{1,64}$"
              }
            ]
          }
        },
        "postgres": {
          "type": "boolean"
        }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "additionalProperties",
        "properties"
      ],
      "description": "Schéma JSON (draft 2020-12, sous-ensemble de la console) des paramètres du module (G3). Chaque propriété a un défaut : aucun réglage obligatoire.",
      "properties": {
        "type": {
          "const": "object"
        },
        "additionalProperties": {
          "const": false
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "default"
            ],
            "properties": {
              "type": {
                "enum": [
                  "string",
                  "integer",
                  "number",
                  "boolean",
                  "array"
                ]
              },
              "default": {
                "description": "Valeur par défaut, obligatoire (principe 8). Sa conformité à la propriété est contrôlée par tests/b10 et par le helper."
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "enum": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "uniqueItems": true
              },
              "minimum": {
                "type": "number"
              },
              "maximum": {
                "type": "number"
              },
              "minLength": {
                "type": "integer",
                "minimum": 0
              },
              "maxLength": {
                "type": "integer",
                "minimum": 1
              },
              "pattern": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "string"
                  },
                  "enum": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 100,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "maxLength": 200
                    }
                  },
                  "pattern": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "minLength": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "maxLength": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              "minItems": {
                "type": "integer",
                "minimum": 0
              },
              "maxItems": {
                "type": "integer",
                "minimum": 1
              },
              "uniqueItems": {
                "type": "boolean"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "array"
                    }
                  }
                },
                "then": {
                  "required": [
                    "items"
                  ]
                },
                "else": {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "items"
                        ]
                      },
                      {
                        "required": [
                          "minItems"
                        ]
                      },
                      {
                        "required": [
                          "maxItems"
                        ]
                      },
                      {
                        "required": [
                          "uniqueItems"
                        ]
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    },
    "options_i18n": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fr": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            }
          },
          "en": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            }
          }
        }
      },
      "description": "Traductions des titres et descriptions d'options, par nom d'option."
    },
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputs",
        "command",
        "timeout_s",
        "network"
      ],
      "properties": {
        "inputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "repo",
              "archive",
              "image",
              "sbom",
              "url"
            ]
          }
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "description": "argv complet ; command[0] est passé en --entrypoint."
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 500
          },
          "description": "Variables d'environnement du conteneur (noms : ^[A-Z][A-Z0-9_]*$, contrôlé par b10)."
        },
        "timeout_s": {
          "type": "integer",
          "minimum": 10,
          "maximum": 86400
        },
        "network": {
          "anyOf": [
            {
              "enum": [
                "none",
                "target",
                "ai-relay"
              ]
            },
            {
              "type": "string",
              "pattern": "^service:[a-z0-9][a-z0-9-]{1,40}$"
            }
          ],
          "description": "Réseau du conteneur : « none » (défaut), « target » (DAST), « service:<id> » (contrat 12 de la 0.4) : rattaché au seul réseau interne scanoria-mod-<id>_scan du module service <id>, qui doit être installé et actif ; jeton d'analyse du service passé par un secret Podman. « ai-relay » (0.7, contrat 31) : module d'analyse par IA, toujours sans réseau, relié au relais compatible OpenAI de scanoria-ai par le pont de l'appliance (OPENAI_BASE_URL, jeton éphémère) ; ses résultats sont marqués IA et hors verdict tant qu'une personne ne les a pas confirmés (contrat 32). Sans connecteur IA, le module est « skipped »."
        },
        "exit_codes_ok": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "history": {
          "enum": [
            "shallow",
            "full"
          ],
          "default": "shallow",
          "description": "Historique Git lu par le scanner (contrat 9 de la 0.3) : « full » demande un clone complet et lance history_command s'il existe ; une option booléenne « history » à false le désactive pour un projet."
        },
        "history_command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "description": "argv lancé à la place de command quand la source est un dépôt Git lu avec son historique (history: full) ; le dépôt Git est monté en lecture seule sur /git."
        },
        "sbom_command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "description": "argv lancé à la place de command quand la source est un SBOM (entrée « sbom », re-corrélation de la 0.5, contrat 16) : le runner écrit le CycloneDX dans /src/sbom.cdx.json (lecture seule). Sans ce champ, le module est ignoré (skipped) pour une source SBOM."
        },
        "severity_map": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "description": "Correspondance des gravités natives de l'outil vers la gravité normalisée (G5), lue par l'ingestion pour remplir severity_maps ; facultative."
        },
        "refs": {
          "enum": [
            "any",
            "default-branch"
          ],
          "default": "any",
          "description": "Références analysées : « default-branch » limite le module à la branche par défaut du projet (SonarQube Community Build) ; ailleurs, module « skipped » avec sa raison, sans effet sur le verdict (G13 ne s'applique pas). Voir aussi refs_feature."
        },
        "refs_feature": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,30}$",
          "description": "Avec refs « default-branch » : fonction du service visé (service.features) qui, active, permet d'analyser aussi les autres branches ; la branche est alors transmise par SCANORIA_BRANCH. Ignoré par les appliances antérieures à 0.5, qui restent sur la branche par défaut."
        },
        "tool": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,40}$",
          "description": "Outil de l'appliance monté en lecture seule sur /scanoria : /usr/lib/scanoria/scan-tools/<tool> (convertisseur, orchestration). Livré et signé avec l'appliance, jamais avec le catalogue."
        },
        "incremental": {
          "type": "boolean",
          "default": false,
          "description": "0.7 (contrat 33, G18) : le module sait se limiter aux fichiers modifiés d'une PR, listés un par ligne dans /changed-files.txt (variable SCANORIA_CHANGED_FILES). Sans cette déclaration, il analyse tout le dépôt, même pour une PR. Sa sortie n'est alors jamais mise en cache (V4)."
        },
        "prefers_sbom": {
          "type": "boolean",
          "default": false,
          "description": "Dans une analyse qui a produit un SBOM (contrat 14 de la 0.5), le module lance sbom_command sur ce SBOM (monté sur /src) au lieu d'analyser le dépôt (Grype). Sans prefers_sbom, sbom_command ne sert qu'à la re-corrélation."
        },
        "requires_sbom": {
          "type": "boolean",
          "default": false,
          "description": "Le module ne lit que le SBOM de l'analyse (/sbom/sbom.cdx.json) : sans SBOM, il est « skipped » avec sa raison, sans effet sur le verdict. Il tourne après les modules qui produisent le SBOM."
        },
        "relay_python": {
          "type": "string",
          "pattern": "^(python3|/[A-Za-z0-9._/-]{1,120}/python3(\\.[0-9]{1,2})?)$",
          "description": "Avec scan.network: ai-relay : interpréteur Python de l'image qui lance le pont du relais (python3 par défaut, sinon un chemin absolu)."
        },
        "service_optional": {
          "type": "boolean",
          "default": false,
          "description": "Avec scan.network: service:<id> : si le service est désactivé ou indisponible, le module est « skipped » (complément facultatif, comme l'envoi des SBOM à Dependency-Track) au lieu d'être manquant (G13)."
        },
        "companion": {
          "enum": [
            "quality",
            "sast",
            "secrets",
            "sca",
            "iac",
            "container",
            "sbom",
            "dast",
            "lint",
            "licenses",
            "vuln-management",
            "ci"
          ],
          "description": "Module d'appoint (0.5) : planifié seulement quand un autre module du plan couvre cette catégorie (reach-index avec sca, pour I11) ; jamais compté dans la couverture (G15), et son échec ne rend pas le verdict non concluant (G13). Il ne produit aucun résultat d'analyse."
        },
        "cache": {
          "enum": ["sonar-plugins"],
          "description": "V10 (0.6) : cache persistant du module, propre au projet, monté sur /cache (variable SCANORIA_CACHE_DIR). Après chaque passage, le runner ne garde que ce que la politique autorise et dont il a vérifié l'empreinte (sonar-plugins : cache/<MD5 ou SHA-256>/<nom>.jar). Ignoré par les appliances antérieures à 0.6."
        },
        "applies_to": {
          "type": "object",
          "additionalProperties": false,
          "description": "0.6 (V6, contrat 23) : fichiers qui concernent le module. Sans aucun fichier correspondant dans /src, le module n'est pas lancé : statut « not-applicable », noté dans la couverture (G15), jamais compté comme absent (G13). Sans applies_to, le module tourne toujours.",
          "properties": {
            "detect": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "containers",
                  "terraform",
                  "helm",
                  "ansible",
                  "ci",
                  "shell",
                  "python",
                  "javascript",
                  "go",
                  "java",
                  "lockfiles",
                  "manifests"
                ]
              },
              "description": "Clés de la détection F1, relevées par le runner sur les chemins (applicability.py)."
            },
            "paths": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9._*?/{},\\[\\]-]+$",
                "not": {
                  "pattern": "(^/|\\.\\.)"
                }
              },
              "description": "Motifs de chemins relatifs à la racine (« ** » : tout sous-répertoire, « * » : un segment)."
            }
          }
        },
        "rulesets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["engine", "mount"],
          "description": "0.7 (G4, contrat 34) : le module lit les jeux de règles de la console pour ce moteur. Le runner monte en lecture seule les versions retenues par le plan sous <mount>/<slug>/ (fichier rules.yaml, gitleaks.toml ou policies.yaml ; requêtes KICS dépliées en <id>/query.rego et metadata.json), toujours, vide si aucun jeu n'est rattaché ; leurs sha256 sont figés dans le plan (G11). required : sans jeu de règles du moteur rattaché au profil, le module n'est pas planifié (Semgrep CE). Le code de sortie 3 de l'outil signale un jeu de règles refusé par le moteur (E_RULESET_INVALID, classe input).",
          "properties": {
            "engine": {
              "enum": ["opengrep", "semgrep", "gitleaks", "checkov", "kics"]
            },
            "mount": {
              "const": "/rules"
            },
            "required": {
              "type": "boolean"
            },
            "env": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{1,40}$",
              "description": "Moteur à un seul fichier de configuration (gitleaks : GITLEAKS_CONFIG) : un seul jeu de règles est retenu, et son chemin passe dans cette variable."
            }
          }
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sarif": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "version"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/out/[A-Za-z0-9._-]+$"
            },
            "version": {
              "const": "2.1.0"
            }
          }
        },
        "cyclonedx": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "version"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/out/[A-Za-z0-9._-]+$"
            },
            "version": {
              "type": "string",
              "pattern": "^1\\.[0-9]+$"
            }
          }
        }
      }
    },
    "testbed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "expect"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._+@-]+(/[A-Za-z0-9._+@-]+)*/?$",
          "not": {
            "pattern": "(^|/)\\.\\.?(/|$)"
          }
        },
        "expect": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rule",
              "min"
            ],
            "properties": {
              "rule": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "category": {
                "enum": [
                  "quality",
                  "sast",
                  "secrets",
                  "sca",
                  "iac",
                  "container",
                  "sbom",
                  "dast",
                  "lint",
                  "licenses",
                  "vuln-management",
                  "ci",
                  "system"
                ]
              },
              "min": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              }
            }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port",
        "health_path",
        "units"
      ],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "health_path": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9._~/?=&%-]*$"
        },
        "units": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        },
        "volumes": {
          "description": "Volumes Podman nommés du service (0.4, contrat 10).",
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "path"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,30}$"
              },
              "path": {
                "type": "string",
                "pattern": "^/[A-Za-z0-9._/-]{1,200}$"
              }
            }
          }
        },
        "env": {
          "description": "Variables d'environnement NON secrètes. Gabarits : {db_host} {db_port} {db_name} {db_user} {db_url_jdbc} {hostname} {host_port} {opt.<nom>}. Un secret passe par service.secrets. Noms de variables : ^[A-Z][A-Z0-9_]{0,63}$, hors LD_*, PATH et HOME (contrôlé par le helper).",
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 1024,
            "not": {
              "pattern": "\\{db_password\\}"
            }
          }
        },
        "backup": {
          "description": "Volumes (noms de service.volumes) inclus dans la sauvegarde du module ; la base est sauvegardée d'office si needs.postgres. Absent : tous les volumes.",
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,30}$"
          }
        },
        "secrets": {
          "description": "Secrets générés par le helper (jamais par la console), fichiers root 0600 transmis par secret Podman : monté en /run/secrets/<nom>, ou injecté dans la variable env. « db-password » est réservé aux modules needs.postgres et créé d'office.",
          "type": "array",
          "maxItems": 16,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,40}$"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,40}$"
                  },
                  "env": {
                    "type": "string",
                    "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
                    "not": {
                      "pattern": "^(LD_|PATH$|HOME$)"
                    }
                  }
                }
              }
            ]
          }
        },
        "egress": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$"
          },
          "description": "Hôtes Internet joints par le service lui-même (miroirs de vulnérabilités de Dependency-Track…), déclarés pour l'affichage et la documentation ; le réseau propre du module sort par la passerelle de Podman, sans filtrage par nom (CLAUDE.md § 3.2). Absent : aucun accès sortant attendu."
        },
        "features": {
          "description": "Fonctions optionnelles du service, chacune portée par l'option booléenne du même nom (options) et fournie par une variante d'image (service.variants). Sans variante compatible, la fonction est déclarée indisponible avec sa raison.",
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,30}$"
          }
        },
        "variants": {
          "description": "Variantes d'image : la même application à la même version (base_version = version), avec une extension tierce (ex. plugin de branches de SonarQube). Retenue si l'option « feature » est vraie et si version partage la version majeure et mineure du module ; sinon l'image d'origine est gardée. leaves : fichiers que la variante dépose dans un volume, retirés quand elle n'est plus active.",
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "feature",
              "option",
              "image",
              "version",
              "base_version",
              "license",
              "upstream"
            ],
            "properties": {
              "feature": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,30}$"
              },
              "option": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,30}$"
              },
              "image": {
                "type": "string",
                "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+(:[0-9]{1,5})?(/[a-z0-9]+([._-]{1,2}[a-z0-9]+)*)+@sha256:[0-9a-f]{64}$",
                "maxLength": 300,
                "description": "Image épinglée par empreinte, registre explicite (pas de nom court), sans étiquette."
              },
              "version": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9A-Za-z.+_-]{1,60}$"
              },
              "base_version": {
                "type": "string",
                "pattern": "^[0-9A-Za-z][0-9A-Za-z.+_-]{0,63}$",
                "description": "Version de l'outil (ou du format pour un feed), utilisable dans un nom de fichier."
              },
              "license": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "spdx",
                  "url",
                  "verified_at"
                ],
                "properties": {
                  "spdx": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "url": {
                    "type": "string",
                    "pattern": "^https://"
                  },
                  "verified_at": {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                  },
                  "restrictions": {
                    "const": "none",
                    "description": "Une variante n'ajoute qu'une extension libre, sans restriction (principe 1)."
                  }
                }
              },
              "upstream": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source"
                ],
                "properties": {
                  "source": {
                    "type": "string",
                    "pattern": "^https://"
                  },
                  "image": {
                    "type": "string",
                    "pattern": "^https://"
                  }
                }
              },
              "notes": {
                "type": "string",
                "maxLength": 1000
              },
              "leaves": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "volume",
                    "dir",
                    "prefix"
                  ],
                  "properties": {
                    "volume": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]{0,30}$"
                    },
                    "dir": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]{0,63}$"
                    },
                    "prefix": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,80}$"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "feed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "mount",
        "max_age_days",
        "source"
      ],
      "properties": {
        "format": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,40}$"
        },
        "mount": {
          "type": "string",
          "pattern": "^/feeds/[a-z0-9][a-z0-9-]{1,40}$"
        },
        "max_age_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "ref"
          ],
          "properties": {
            "kind": {
              "enum": [
                "oci",
                "https"
              ]
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "mirrors": {
              "description": "Sources de secours, essayées dans l'ordre si ref échoue (même kind), par exemple quand un registre limite le débit (0.3.4).",
              "type": "array",
              "maxItems": 4,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            }
          }
        },
        "schedule": {
          "enum": [
            "daily",
            "weekly",
            "manual"
          ]
        },
        "hydrate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "image",
            "command"
          ],
          "description": "Préparation de la base téléchargée par l'outil qui la lit (grype-db : index reconstruits par « grype db import »), dans un conteneur jetable confiné, sans réseau ; la base est montée sur /db (seul répertoire écrivable). L'image est épinglée par empreinte, comme celle d'un module.",
          "properties": {
            "image": {
              "type": "string",
              "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+(:[0-9]{1,5})?(/[a-z0-9]+([._-]{1,2}[a-z0-9]+)*)+@sha256:[0-9a-f]{64}$",
              "maxLength": 300
            },
            "command": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "env": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "maxLength": 500
              }
            },
            "memory_mb": {
              "type": "integer",
              "minimum": 128,
              "maximum": 16384
            },
            "timeout_s": {
              "type": "integer",
              "minimum": 30,
              "maximum": 7200
            }
          }
        },
        "export": {
          "description": "Export de la base pour la console (0.5, contrat 17) : le helper écrit /var/lib/scanoria/feeds-export/<id>.jsonl.gz après chaque mise à jour (EPSS, KEV).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format"
          ],
          "properties": {
            "format": {
              "enum": [
                "jsonl.gz"
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "properties": {
                  "kind": {
                    "const": "https"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "source": {
                "properties": {
                  "ref": {
                    "pattern": "^https://"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command"
      ],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    },
    "upgrade": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy"
      ],
      "properties": {
        "policy": {
          "enum": [
            "on-demand"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "scanner"
          }
        }
      },
      "then": {
        "required": [
          "scan",
          "outputs",
          "testbed"
        ],
        "properties": {
          "hostname": {
            "type": "null"
          },
          "outputs": {
            "anyOf": [
              {
                "required": [
                  "sarif"
                ]
              },
              {
                "required": [
                  "cyclonedx"
                ]
              }
            ]
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "service"
              ]
            },
            {
              "required": [
                "feed"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "service"
          }
        }
      },
      "then": {
        "required": [
          "service",
          "hostname"
        ],
        "properties": {
          "hostname": {
            "type": "string"
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "scan"
              ]
            },
            {
              "required": [
                "feed"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "feed"
          }
        }
      },
      "then": {
        "required": [
          "feed"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "scan"
              ]
            },
            {
              "required": [
                "service"
              ]
            },
            {
              "required": [
                "outputs"
              ]
            },
            {
              "required": [
                "testbed"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "runner"
          }
        }
      },
      "then": {
        "required": [],
        "not": {
          "anyOf": [
            {
              "required": [
                "scan"
              ]
            },
            {
              "required": [
                "feed"
              ]
            },
            {
              "required": [
                "testbed"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "scan"
        ],
        "properties": {
          "scan": {
            "properties": {
              "network": {
                "const": "target"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "categories": {
            "items": {
              "const": "dast"
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "scanner",
              "service",
              "runner"
            ]
          }
        }
      },
      "then": {
        "oneOf": [
          {
            "required": [
              "image"
            ],
            "not": {
              "required": [
                "image_pending"
              ]
            }
          },
          {
            "required": [
              "image_pending"
            ],
            "not": {
              "required": [
                "image"
              ]
            }
          }
        ]
      },
      "else": {
        "not": {
          "required": [
            "image_pending"
          ]
        }
      }
    }
  ]
}
