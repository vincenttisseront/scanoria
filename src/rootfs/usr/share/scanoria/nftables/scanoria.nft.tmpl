#
# Gabarit de la table nftables « inet scanoria » (ARCHITECTURE § 4), rendu par
# scanoria-firewall depuis /etc/scanoria/admin-networks.json. Seule cette
# table est gérée : jamais de « flush ruleset ». Entrant : boucle locale,
# connexions établies, ICMP nécessaire, client DHCP, puis SSH/HTTP/HTTPS
# depuis les réseaux d'administration seulement, et PostgreSQL depuis les
# réseaux des modules permanents. Sortant libre.
table inet scanoria
delete table inet scanoria
table inet scanoria {
	set admin4 {
		type ipv4_addr
		flags interval
		auto-merge
@ADMIN4@
	}

	set admin6 {
		type ipv6_addr
		flags interval
		auto-merge
@ADMIN6@
	}

	chain input {
		type filter hook input priority filter; policy drop;
		iif "lo" accept
		ct state invalid drop
		ct state established,related accept
		ip protocol icmp icmp type { destination-unreachable, time-exceeded, parameter-problem } accept
		ip protocol icmp icmp type echo-request limit rate 10/second accept
		meta l4proto ipv6-icmp icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } accept
		meta l4proto ipv6-icmp icmpv6 type echo-request limit rate 10/second accept
		udp sport 67 udp dport 68 accept
		ip6 saddr fe80::/10 udp sport 547 udp dport 546 accept
		ip saddr @admin4 tcp dport { 22, 80, 443 } accept
		ip6 saddr @admin6 tcp dport { 22, 80, 443 } accept
		# Modules permanents vers PostgreSQL (pool de services-network.conf) ;
		# pg_hba n'accepte que le sous-réseau propre à chaque module.
		iifname "podman*" ip saddr 10.90.0.0/16 tcp dport 5432 accept
		# Bases de vulnérabilités servies par l'appliance aux modules permanents
		# (Dependency-Track hors ligne, 0.6) : nginx, port 9790, lecture seule.
		iifname "podman*" ip saddr 10.90.0.0/16 tcp dport 9790 accept
		# Résolution des noms entre conteneurs (aardvark-dns, à l'écoute sur la
		# passerelle de chaque réseau Podman) : sans elle, un scanner rattaché au
		# réseau interne d'un service (dtrack-upload → Dependency-Track) ne trouve
		# pas le service. Les conteneurs sans réseau (--network=none) ne sont pas
		# concernés.
		iifname "podman*" meta l4proto { tcp, udp } th dport 53 accept
	}
}
