# Site nginx de l'appliance, généré par scanoria-helper (set-hostname) depuis
# /usr/share/scanoria/nginx/scanoria.conf.tmpl : @FQDN@ = nom de l'appliance.
# Contrôlé par « nginx -t » avant rechargement ; ancien fichier remis sinon.
#
#   :80   redirection vers https://@FQDN@ ; /scanoria-ca.crt servi en clair
#   :443  @FQDN@ -> console (127.0.0.1:3000) ; *.@FQDN@ : modules (0.2,
#         /etc/nginx/scanoria.d/*.conf) ; tout autre nom : 444

map $http_upgrade $scanoria_connection_upgrade {
	default upgrade;
	"" close;
}

server {
	listen 80 default_server;
	listen [::]:80 default_server;
	server_name _;
	server_tokens off;

	location = /scanoria-ca.crt {
		alias /etc/nginx/scanoria/scanoria-ca.crt;
		default_type application/x-x509-ca-cert;
		add_header Content-Disposition 'attachment; filename="scanoria-ca.crt"' always;
		add_header X-Content-Type-Options nosniff always;
	}

	location / {
		return 301 https://@FQDN@$request_uri;
	}
}

# Nom inconnu : connexion fermée sans réponse.
server {
	listen 443 ssl http2 default_server;
	listen [::]:443 ssl http2 default_server;
	server_name _;
	server_tokens off;
	ssl_certificate /etc/scanoria/pki/active/fullchain.pem;
	ssl_certificate_key /etc/scanoria/pki/active/privkey.pem;
	# Le nginx.conf de la distribution fixe déjà ces directives au niveau http :
	# elles sont redéfinies ici, au niveau server.
	ssl_protocols TLSv1.2 TLSv1.3;
	ssl_ecdh_curve X25519:prime256v1:secp384r1;
	ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
	ssl_prefer_server_ciphers off;
	ssl_session_cache shared:scanoria_tls:10m;
	ssl_session_timeout 1d;
	ssl_session_tickets off;
	return 444;
}

# Console.
server {
	listen 443 ssl http2;
	listen [::]:443 ssl http2;
	server_name @FQDN@;
	server_tokens off;
	ssl_certificate /etc/scanoria/pki/active/fullchain.pem;
	ssl_certificate_key /etc/scanoria/pki/active/privkey.pem;
	# Le nginx.conf de la distribution fixe déjà ces directives au niveau http :
	# elles sont redéfinies ici, au niveau server.
	ssl_protocols TLSv1.2 TLSv1.3;
	ssl_ecdh_curve X25519:prime256v1:secp384r1;
	ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
	ssl_prefer_server_ciphers off;
	ssl_session_cache shared:scanoria_tls:10m;
	ssl_session_timeout 1d;
	ssl_session_tickets off;

	add_header Strict-Transport-Security "max-age=31536000" always;
	add_header X-Content-Type-Options nosniff always;
	add_header X-Frame-Options DENY always;
	add_header Referrer-Policy no-referrer always;
	add_header Cross-Origin-Opener-Policy same-origin always;
	add_header Cross-Origin-Resource-Policy same-origin always;
	add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;

	client_max_body_size 1m;
	proxy_http_version 1.1;
	proxy_set_header Host $host;
	proxy_set_header X-Real-IP $remote_addr;
	proxy_set_header X-Forwarded-For $remote_addr;
	proxy_set_header X-Forwarded-Proto https;
	proxy_set_header X-Forwarded-Host $host;
	proxy_set_header Upgrade $http_upgrade;
	proxy_set_header Connection $scanoria_connection_upgrade;
	proxy_hide_header X-Powered-By;
	proxy_read_timeout 300s;

	location = /scanoria-ca.crt {
		alias /etc/nginx/scanoria/scanoria-ca.crt;
		default_type application/x-x509-ca-cert;
		add_header Content-Disposition 'attachment; filename="scanoria-ca.crt"' always;
		add_header X-Content-Type-Options nosniff always;
	}

	# Téléversement d'une mise à jour (lot de 1 Gio au plus), sans tampon disque.
	location ^~ /api/system/updates/upload {
		client_max_body_size 1g;
		proxy_request_buffering off;
		proxy_read_timeout 900s;
		proxy_pass http://127.0.0.1:3000;
	}

	# Lots hors ligne (0.6) : téléversement (images des modules, 64 Gio au plus)
	# et téléchargement, en flux, sans tampon disque.
	location ^~ /api/system/offline/uploads {
		client_max_body_size 64g;
		proxy_request_buffering off;
		proxy_read_timeout 3600s;
		proxy_pass http://127.0.0.1:3000;
	}
	location ^~ /api/system/offline/bundles/ {
		proxy_buffering off;
		proxy_read_timeout 3600s;
		proxy_pass http://127.0.0.1:3000;
	}

	location / {
		proxy_pass http://127.0.0.1:3000;
	}
}

# Modules (0.2) : un fichier par module actif, server_name <libellé>.@FQDN@.
include /etc/nginx/scanoria.d/*.conf;
