{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scanoria:schema:request:export-bundle:1",
  "$comment": "SPDX-License-Identifier: AGPL-3.0-or-later. Copyright (C) 2026 Vincent Tisseront. Contrat : docs/ARCHITECTURE.md.",
  "title": "Exporter un lot hors ligne signé",
  "description": "Construit sous /var/lib/scanoria/bundles/ une archive tar signée par la clé de l'appliance : index du catalogue (toujours), images des modules choisis (dépôt OCI, empreintes conservées), bancs d'essai et bases feed dont ils dépendent (G1). dry_run estime seulement la taille. schedule enregistre l'export périodique (/etc/scanoria/bundle-export.json) ; scheduled est réservé au minuteur. Rotation : keep lots gardés. CLAUDE.md § 9.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "type",
    "created_at",
    "requested_by",
    "params"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "type": {
      "const": "export-bundle"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "requested_by": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_id",
        "username"
      ],
      "properties": {
        "user_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "username": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "address": {
          "type": "string",
          "maxLength": 45,
          "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}|[0-9a-f.]*:[0-9a-f:.]*)$"
        }
      }
    },
    "params": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "modules"
          ],
          "properties": {
            "modules": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{1,40}$"
              }
            },
            "dry_run": {
              "type": "boolean"
            },
            "keep": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schedule"
          ],
          "properties": {
            "schedule": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled",
                "every_days",
                "keep",
                "modules"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "every_days": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 31
                },
                "keep": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10
                },
                "modules": {
                  "type": "array",
                  "minItems": 0,
                  "maxItems": 64,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]{1,40}$"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scheduled"
          ],
          "properties": {
            "scheduled": {
              "const": true
            }
          }
        }
      ]
    }
  }
}
