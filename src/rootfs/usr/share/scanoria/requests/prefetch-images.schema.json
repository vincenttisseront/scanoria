{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scanoria:schema:request:prefetch-images:1",
  "$comment": "SPDX-License-Identifier: AGPL-3.0-or-later. Copyright (C) 2026 Vincent Tisseront. Contrat : docs/ARCHITECTURE.md.",
  "title": "Précharger les images des modules",
  "description": "Vérifie que l'image de chaque module installé est présente sous son empreinte, et récupère celles qui manquent depuis le registre (V1) ; params.pins ajoute les versions figées par les projets (G6), acceptées seulement si l'index du catalogue signé les connaît avec la même empreinte. Lancé aussi chaque jour par scanoria-prefetch-images.timer, et par le worker après une image absente.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "type",
    "created_at",
    "requested_by",
    "params"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "type": {
      "const": "prefetch-images"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "requested_by": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_id",
        "username"
      ],
      "properties": {
        "user_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "username": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "address": {
          "type": "string",
          "maxLength": 45,
          "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}|[0-9a-f.]*:[0-9a-f:.]*)$"
        }
      }
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pins": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "module_id",
              "version",
              "image_digest"
            ],
            "properties": {
              "module_id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{1,40}$"
              },
              "version": {
                "type": "string",
                "pattern": "^[0-9A-Za-z][0-9A-Za-z.+_-]{0,63}$"
              },
              "image_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
