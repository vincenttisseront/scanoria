{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scanoria:schema:request:set-ai-endpoint:1",
  "$comment": "SPDX-License-Identifier: AGPL-3.0-or-later. Copyright (C) 2026 Vincent Tisseront. Contrat : docs/ARCHITECTURE.md.",
  "title": "Brancher ou retirer le serveur Ollama externe (connecteur IA)",
  "description": "Valide l'adresse (https, ou http avec allow_insecure et sans jeton), résout le nom côté helper, refuse toute adresse de bouclage, de lien local, de multidiffusion, réservée ou de l'appliance, épingle les adresses dans /etc/scanoria/ai.json (schemas/ai-endpoint.schema.json) et ouvre dans nftables (table inet scanoria_ai) la sortie vers ces adresses et ce port pour l'UID de scanoria-ai seulement. enabled: false referme la règle. Le jeton porteur n'est jamais transmis : token indique seulement qu'il existe (chiffré en base), ce qui impose https. skip_tls_verify (https seulement, jamais avec ca_pem) accepte le certificat du serveur sans le vérifier, par exemple un certificat autosigné ; la vérification reste la règle par défaut. CLAUDE.md § 3.5.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "type",
    "created_at",
    "requested_by",
    "params"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "type": {
      "const": "set-ai-endpoint"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "requested_by": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_id",
        "username"
      ],
      "properties": {
        "user_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "username": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "address": {
          "type": "string",
          "maxLength": 45,
          "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}|[0-9a-f.]*:[0-9a-f:.]*)$"
        }
      }
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "url": {
          "type": "string",
          "minLength": 8,
          "maxLength": 300,
          "pattern": "^https?://(\\[[0-9a-f:.]{2,45}\\]|[a-z0-9.-]{1,253})(:[0-9]{1,5})?/?$"
        },
        "allow_insecure": {
          "type": "boolean"
        },
        "token": {
          "type": "boolean"
        },
        "ca_pem": {
          "type": "string",
          "minLength": 64,
          "maxLength": 16384,
          "pattern": "^-----BEGIN CERTIFICATE-----\\r?\\n"
        },
        "skip_tls_verify": {
          "type": "boolean"
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "enabled",
          "url"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "url"
              ]
            },
            {
              "required": [
                "ca_pem"
              ]
            },
            {
              "required": [
                "token"
              ]
            },
            {
              "required": [
                "allow_insecure"
              ]
            },
            {
              "required": [
                "skip_tls_verify"
              ]
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "skip_tls_verify"
            ],
            "properties": {
              "skip_tls_verify": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "url": {
                "pattern": "^https://"
              }
            },
            "not": {
              "required": [
                "ca_pem"
              ]
            }
          }
        }
      ]
    }
  }
}
