{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scanoria:schema:request:import-certificate:1",
  "$comment": "SPDX-License-Identifier: AGPL-3.0-or-later. Copyright (C) 2026 Vincent Tisseront. Contrat : docs/ARCHITECTURE.md.",
  "title": "Importer un certificat",
  "description": "Installe un certificat fourni (PEM). Il doit couvrir <nom> et *.<nom>, être valide, et correspondre à la clé (non chiffrée, RSA >= 2048 ou ECDSA P-256/P-384). La clé n'apparaît jamais dans le résultat.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "type",
    "created_at",
    "requested_by",
    "params"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "type": {
      "const": "import-certificate"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "requested_by": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_id",
        "username"
      ],
      "properties": {
        "user_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "username": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "address": {
          "type": "string",
          "maxLength": 45,
          "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}|[0-9a-f:]*:[0-9a-f:.]*)$"
        }
      }
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cert_pem": {
          "type": "string",
          "maxLength": 16384,
          "pattern": "^-----BEGIN CERTIFICATE-----\\r?\\n"
        },
        "key_pem": {
          "type": "string",
          "maxLength": 16384,
          "pattern": "^-----BEGIN (EC |RSA )?PRIVATE KEY-----\\r?\\n"
        },
        "chain_pem": {
          "type": "string",
          "maxLength": 65536,
          "pattern": "^-----BEGIN CERTIFICATE-----\\r?\\n"
        }
      },
      "required": [
        "cert_pem",
        "key_pem"
      ]
    }
  }
}
