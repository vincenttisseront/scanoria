{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scanoria:schema:result:1",
  "$comment": "SPDX-License-Identifier: AGPL-3.0-or-later. Copyright (C) 2026 Vincent Tisseront. Contrat : docs/ARCHITECTURE.md.",
  "title": "Résultat d'une demande",
  "description": "Écrit par scanoria-helper dans requests/done/ (status ok) ou requests/failed/ (error, rejected), sous le même nom que la demande. Les secrets (key_pem…) n'y figurent jamais.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "type",
    "origin",
    "status",
    "code",
    "message",
    "received_at",
    "finished_at",
    "output"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      ]
    },
    "type": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "set-hostname",
            "set-admin-networks",
            "issue-certificate",
            "import-certificate",
            "check-update",
            "apply-update",
            "rollback-update",
            "set-update-policy",
            "run-selftest",
            "check-dns"
          ]
        }
      ]
    },
    "origin": {
      "enum": [
        "console",
        "timer",
        "firstboot",
        "cli"
      ]
    },
    "status": {
      "enum": [
        "ok",
        "error",
        "rejected"
      ]
    },
    "code": {
      "enum": [
        "OK",
        "E_INVALID_NAME",
        "E_NOT_REGULAR_FILE",
        "E_BAD_OWNER",
        "E_TOO_LARGE",
        "E_INVALID_JSON",
        "E_UNKNOWN_TYPE",
        "E_SCHEMA",
        "E_ID_MISMATCH",
        "E_DUPLICATE_ID",
        "E_STALE",
        "E_INVALID_PARAM",
        "E_PRECONDITION",
        "E_LOCKOUT",
        "E_NETWORK",
        "E_NOT_FOUND",
        "E_SIGNATURE",
        "E_CHECKSUM",
        "E_ARCHIVE",
        "E_VERSION",
        "E_DISK_SPACE",
        "E_CERT_INVALID",
        "E_CERT_NAMES",
        "E_CERT_KEY_MISMATCH",
        "E_CERT_EXPIRED",
        "E_NO_PREVIOUS",
        "E_HEALTH_ROLLED_BACK",
        "E_ROLLBACK_FAILED",
        "E_TIMEOUT",
        "E_INTERNAL"
      ]
    },
    "message": {
      "type": "string",
      "maxLength": 2000
    },
    "received_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "started_at": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
        }
      ]
    },
    "finished_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "output": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "then": {
        "properties": {
          "code": {
            "const": "OK"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "error",
              "rejected"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "code": {
            "not": {
              "const": "OK"
            }
          }
        }
      }
    }
  ]
}
