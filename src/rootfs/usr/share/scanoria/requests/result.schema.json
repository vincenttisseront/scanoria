{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scanoria:schema:result:1",
  "$comment": "SPDX-License-Identifier: AGPL-3.0-or-later. Copyright (C) 2026 Vincent Tisseront. Contrat : docs/ARCHITECTURE.md.",
  "title": "Résultat d'une demande",
  "description": "Écrit par scanoria-helper dans requests/done/ (status ok) ou requests/failed/ (error, rejected), sous le même nom que la demande. Les secrets (key_pem…) n'y figurent jamais.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "type",
    "origin",
    "status",
    "code",
    "message",
    "received_at",
    "finished_at",
    "output"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      ]
    },
    "type": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "set-hostname",
            "set-admin-networks",
            "issue-certificate",
            "import-certificate",
            "check-update",
            "apply-update",
            "rollback-update",
            "set-update-policy",
            "run-selftest",
            "check-dns",
            "refresh-catalog",
            "install-modules",
            "uninstall-module",
            "set-module-state",
            "update-module",
            "set-ai-endpoint",
            "refresh-feeds",
            "backup-module",
            "restore-module",
            "reset-service-admin",
            "package-dates",
            "export-bundle",
            "import-bundle",
            "set-mirror",
            "trust-key",
            "self-sbom",
            "run-canaries",
            "start-trial",
            "prefetch-images",
            "validate-ruleset"
          ]
        }
      ]
    },
    "origin": {
      "enum": [
        "console",
        "timer",
        "firstboot",
        "cli"
      ]
    },
    "status": {
      "enum": [
        "ok",
        "error",
        "rejected"
      ]
    },
    "code": {
      "enum": [
        "OK",
        "E_INVALID_NAME",
        "E_NOT_REGULAR_FILE",
        "E_BAD_OWNER",
        "E_TOO_LARGE",
        "E_INVALID_JSON",
        "E_UNKNOWN_TYPE",
        "E_SCHEMA",
        "E_ID_MISMATCH",
        "E_DUPLICATE_ID",
        "E_STALE",
        "E_INVALID_PARAM",
        "E_PRECONDITION",
        "E_LOCKOUT",
        "E_NETWORK",
        "E_NOT_FOUND",
        "E_SIGNATURE",
        "E_CHECKSUM",
        "E_ARCHIVE",
        "E_VERSION",
        "E_DISK_SPACE",
        "E_CERT_INVALID",
        "E_CERT_NAMES",
        "E_CERT_KEY_MISMATCH",
        "E_CERT_EXPIRED",
        "E_NO_PREVIOUS",
        "E_HEALTH_ROLLED_BACK",
        "E_ROLLBACK_FAILED",
        "E_TIMEOUT",
        "E_INTERNAL",
        "E_RESOURCES",
        "E_DEPENDENCY",
        "E_CONFLICT",
        "E_LICENSE",
        "E_TESTBED",
        "E_AI_URL",
        "E_AI_UNRESOLVED",
        "E_AI_FORBIDDEN_ADDRESS",
        "E_AI_CA",
        "E_FEED_UNAVAILABLE",
        "E_SERVICE_RESOURCES",
        "E_BACKUP_FAILED",
        "E_BACKUP_NOT_FOUND",
        "E_BACKUP_INVALID",
        "E_SONAR_UNAVAILABLE",
        "E_SONAR_ADMIN",
        "E_SONAR_API",
        "E_DTRACK_UNAVAILABLE",
        "E_DTRACK_ADMIN",
        "E_DTRACK_API",
        "E_EXPORT_FAILED",
        "E_BUNDLE_INVALID",
        "E_BUNDLE_SIGNATURE",
        "E_BUNDLE_UNTRUSTED",
        "E_BUNDLE_CHECKSUM",
        "E_BUNDLE_ARCHIVE",
        "E_BUNDLE_IMAGE",
        "E_BUNDLE_FEED",
        "E_BUNDLE_SOURCE",
        "E_MIRROR_URL",
        "E_MIRROR_UNRESOLVED",
        "E_MIRROR_FORBIDDEN_ADDRESS",
        "E_MIRROR_CA",
        "E_MIRROR_UNTRUSTED",
        "E_MIRROR_UNREACHABLE",
        "E_KEY_INVALID",
        "E_CANARY_FAILED",
        "E_TRIAL_INVALID",
        "E_TRIAL_IMAGE",
        "E_SELFSBOM_IMAGE",
        "E_SELFSBOM_OUTPUT",
        "E_PREFETCH_FAILED",
        "E_PREFETCH_UNKNOWN_IMAGE",
        "E_RULESET_INVALID",
        "E_RULESET_MISSING",
        "E_RULESET_NONE",
        "E_RULESET_ENGINE_MISSING"
      ]
    },
    "message": {
      "type": "string",
      "maxLength": 2000
    },
    "received_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "started_at": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
        }
      ]
    },
    "finished_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "output": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "then": {
        "properties": {
          "code": {
            "const": "OK"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "error",
              "rejected"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "code": {
            "not": {
              "const": "OK"
            }
          }
        }
      }
    }
  ]
}
