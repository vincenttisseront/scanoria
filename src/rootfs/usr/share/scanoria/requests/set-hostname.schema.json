{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scanoria:schema:request:set-hostname:1",
  "$comment": "SPDX-License-Identifier: AGPL-3.0-or-later. Copyright (C) 2026 Vincent Tisseront. Contrat : docs/ARCHITECTURE.md.",
  "title": "Changer le nom de l'appliance",
  "description": "Pose le nom complet (FQDN) de l'appliance : hostname, nginx, nouvelle AC interne (contrainte de nom) et nouveau certificat <nom> / *.<nom>. En mode TLS importé, repasse en mode interne.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "type",
    "created_at",
    "requested_by",
    "params"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "type": {
      "const": "set-hostname"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "requested_by": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_id",
        "username"
      ],
      "properties": {
        "user_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "username": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "address": {
          "type": "string",
          "maxLength": 45,
          "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}|[0-9a-f.]*:[0-9a-f:.]*)$"
        }
      }
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fqdn": {
          "type": "string",
          "minLength": 4,
          "maxLength": 253,
          "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]([a-z0-9-]{0,61}[a-z0-9])?$"
        }
      },
      "required": [
        "fqdn"
      ]
    }
  }
}
