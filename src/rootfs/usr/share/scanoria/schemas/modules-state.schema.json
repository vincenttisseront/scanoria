{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scanoria:schema:modules-state:1",
  "$comment": "SPDX-License-Identifier: AGPL-3.0-or-later. Copyright (C) 2026 Vincent Tisseront. Contrat 4 de la 0.2.",
  "title": "État des modules",
  "description": "Publié par scanoria-helper dans /var/lib/scanoria/modules/state.json (root:scanoria 0640) après chaque changement, lu par la console. operations garde les 20 dernières opérations, avec leur progression (indicateur d'attente).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "updated_at",
    "modules",
    "operations"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "updated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "modules": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "type",
          "status",
          "enabled",
          "installed_at",
          "options",
          "testbed",
          "route",
          "last_error"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,40}$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9A-Za-z][0-9A-Za-z.+_-]{0,63}$"
          },
          "type": {
            "enum": [
              "scanner",
              "service",
              "feed",
              "runner"
            ]
          },
          "status": {
            "enum": [
              "installing",
              "testing",
              "healthy",
              "failed",
              "disabled",
              "removing"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "installed_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
          },
          "options": {
            "type": "object"
          },
          "testbed": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "passed",
                  "at",
                  "details"
                ],
                "properties": {
                  "passed": {
                    "type": "boolean"
                  },
                  "at": {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
                  },
                  "details": {
                    "oneOf": [
                      {
                        "type": "string",
                        "maxLength": 500
                      },
                      {
                        "type": "array",
                        "maxItems": 100,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "rule",
                            "category",
                            "min",
                            "found",
                            "ok"
                          ],
                          "properties": {
                            "rule": {
                              "type": [
                                "string",
                                "null"
                              ],
                              "maxLength": 200
                            },
                            "category": {
                              "type": [
                                "string",
                                "null"
                              ],
                              "maxLength": 100
                            },
                            "min": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "found": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "ok": {
                              "type": "boolean"
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              }
            ]
          },
          "route": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "hostname",
                  "url"
                ],
                "properties": {
                  "hostname": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 253
                  },
                  "url": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 300
                  }
                }
              }
            ]
          },
          "last_error": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          }
        }
      }
    },
    "operations": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "request_id",
          "kind",
          "module",
          "step",
          "progress",
          "started_at",
          "finished_at",
          "result",
          "message"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "request_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "kind": {
            "enum": [
              "install",
              "uninstall",
              "enable",
              "disable",
              "update"
            ]
          },
          "module": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,40}$"
          },
          "step": {
            "type": "string",
            "pattern": "^[a-z][a-z-]{0,31}$"
          },
          "progress": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "started_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
          },
          "finished_at": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
              }
            ]
          },
          "result": {
            "enum": [
              null,
              "ok",
              "failed"
            ]
          },
          "message": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          }
        }
      }
    },
    "feeds": {
      "description": "Bases des modules feed (0.3.4) : âge, taille, état du dernier téléchargement. missing : aucune base ; stale : le dernier téléchargement a échoué, la base précédente reste active.",
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "updated_at",
          "size_mb",
          "status",
          "error",
          "checked_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,40}$"
          },
          "updated_at": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
              }
            ]
          },
          "checked_at": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
              }
            ]
          },
          "size_mb": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "status": {
            "enum": [
              "ok",
              "stale",
              "failed",
              "missing"
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          }
        }
      }
    }
  }
}
