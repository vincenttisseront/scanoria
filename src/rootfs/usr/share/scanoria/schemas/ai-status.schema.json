{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scanoria:schema:ai-status:1",
  "$comment": "SPDX-License-Identifier: AGPL-3.0-or-later. Copyright (C) 2026 Vincent Tisseront. Contrat : CLAUDE.md § 3.5.",
  "title": "Contrôle du connecteur IA (/run/scanoria/ai-status.json)",
  "description": "Écrit par scanoria-ai-setup check (toutes les heures) et après chaque set-ai-endpoint. Un changement de résolution est signalé, jamais appliqué ; le candidat ollama.<domaine> n'est cherché que sans connecteur.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "checked_at",
    "enabled",
    "resolution",
    "candidate"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "checked_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "enabled": {
      "type": "boolean"
    },
    "resolution": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pinned",
            "current",
            "changed",
            "error"
          ],
          "properties": {
            "pinned": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "string",
                "maxLength": 45,
                "pattern": "^([0-9]{1,3}(\\.[0-9]{1,3}){3}|[0-9a-f:.]*:[0-9a-f:.]*)$"
              }
            },
            "current": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "string",
                "maxLength": 45,
                "pattern": "^([0-9]{1,3}(\\.[0-9]{1,3}){3}|[0-9a-f:.]*:[0-9a-f:.]*)$"
              }
            },
            "changed": {
              "type": "boolean"
            },
            "error": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^E_[A-Z_]+$"
                }
              ]
            }
          }
        }
      ]
    },
    "candidate": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "version",
            "addresses",
            "insecure"
          ],
          "properties": {
            "url": {
              "type": "string",
              "maxLength": 300,
              "pattern": "^https?://"
            },
            "version": {
              "type": "string",
              "maxLength": 64
            },
            "addresses": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "string",
                "maxLength": 45,
                "pattern": "^([0-9]{1,3}(\\.[0-9]{1,3}){3}|[0-9a-f:.]*:[0-9a-f:.]*)$"
              }
            },
            "insecure": {
              "type": "boolean"
            }
          }
        }
      ]
    }
  }
}
