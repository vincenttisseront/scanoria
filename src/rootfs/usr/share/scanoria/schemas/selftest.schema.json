{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scanoria:schema:selftest:1",
  "$comment": "SPDX-License-Identifier: AGPL-3.0-or-later. Copyright (C) 2026 Vincent Tisseront. Contrat : docs/ARCHITECTURE.md.",
  "title": "Rapport de scanoria-selftest --json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "appliance_version",
    "started_at",
    "finished_at",
    "status",
    "checks"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "appliance_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,3})\\.(0|[1-9][0-9]{0,3})\\.(0|[1-9][0-9]{0,3})$"
    },
    "started_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "finished_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "status": {
      "enum": [
        "pass",
        "warn",
        "fail"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)+$"
          },
          "status": {
            "enum": [
              "pass",
              "warn",
              "fail",
              "skip"
            ]
          },
          "message": {
            "type": "string",
            "maxLength": 500
          },
          "details": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "status",
          "message"
        ]
      }
    }
  }
}
