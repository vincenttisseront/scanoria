{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scanoria:schema:ai-endpoint:1",
  "$comment": "SPDX-License-Identifier: AGPL-3.0-or-later. Copyright (C) 2026 Vincent Tisseront. Contrat : CLAUDE.md § 3.5.",
  "title": "Connecteur IA épinglé (/etc/scanoria/ai.json)",
  "description": "Écrit par scanoria-helper (set-ai-endpoint), lu par la console, scanoria-ai (copie dans /run/scanoria-ai) et scanoria-ai-setup. Sans fichier, ou fichier invalide : connecteur inactif.",
  "type": "object",
  "oneOf": [
    {
      "additionalProperties": false,
      "required": [
        "version",
        "enabled"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "enabled": {
          "const": false
        }
      }
    },
    {
      "additionalProperties": false,
      "required": [
        "version",
        "enabled",
        "url",
        "scheme",
        "host",
        "port",
        "addresses",
        "insecure",
        "token",
        "ca",
        "literal",
        "pinned_at"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "enabled": {
          "const": true
        },
        "url": {
          "type": "string",
          "maxLength": 300,
          "pattern": "^https?://"
        },
        "scheme": {
          "enum": [
            "https",
            "http"
          ]
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-z0-9.:-]+$"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "addresses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "maxLength": 45,
            "pattern": "^([0-9]{1,3}(\\.[0-9]{1,3}){3}|[0-9a-f:.]*:[0-9a-f:.]*)$"
          }
        },
        "insecure": {
          "type": "boolean"
        },
        "token": {
          "type": "boolean"
        },
        "ca": {
          "type": "boolean"
        },
        "literal": {
          "type": "boolean"
        },
        "pinned_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
        }
      }
    }
  ]
}
