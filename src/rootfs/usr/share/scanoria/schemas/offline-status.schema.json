{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scanoria:schema:offline-status:1",
  "$comment": "SPDX-License-Identifier: AGPL-3.0-or-later. Copyright (C) 2026 Vincent Tisseront.",
  "title": "État hors ligne publié pour la console (/var/lib/scanoria/offline/status.json)",
  "description": "Clé de l'appliance, clés de confiance, lots exportés, dernier import, miroir déclaré, publication F17, export périodique, sources de Dependency-Track. CLAUDE.md § 9.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "updated_at",
    "appliance_key",
    "trusted_keys",
    "bundles",
    "last_import",
    "mirror",
    "publication",
    "schedule",
    "dtrack"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "updated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "appliance_key": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "public_key",
            "fingerprint"
          ],
          "properties": {
            "public_key": {
              "type": "string",
              "pattern": "^[A-Za-z0-9+/]{43}=$"
            },
            "fingerprint": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "trusted_keys": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "uniqueItems": true
    },
    "bundles": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "name",
          "created_at",
          "size_bytes",
          "sha256",
          "signer_fingerprint",
          "modules"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^scanoria-bundle-[0-9]{8}T[0-9]{6}Z\\.tar$"
          },
          "created_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 68719476736
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "signer_fingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "modules": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{1,40}$"
            }
          }
        }
      }
    },
    "last_import": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object"
        }
      ]
    },
    "mirror": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object"
        }
      ]
    },
    "publication": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object"
        }
      ]
    },
    "schedule": {
      "type": "object",
      "required": [
        "enabled",
        "every_days",
        "keep",
        "modules",
        "last_run_at"
      ]
    },
    "dtrack": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object"
        }
      ]
    }
  }
}
