{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scanoria:schema:bundle-manifest:1",
  "$comment": "SPDX-License-Identifier: AGPL-3.0-or-later. Copyright (C) 2026 Vincent Tisseront.",
  "title": "Manifeste d'un lot hors ligne (manifest.json, signé par manifest.json.sig)",
  "description": "Premier membre de l'archive. Chaque fichier du lot y est déclaré une seule fois avec son SHA-256 et sa taille ; tout autre membre est refusé. CLAUDE.md § 9.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "created_at",
    "signer",
    "appliance_version",
    "modules",
    "catalog",
    "testbeds",
    "feeds",
    "images"
  ],
  "properties": {
    "format": {
      "const": 1
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "signer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fingerprint",
        "public_key"
      ],
      "properties": {
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "public_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{43}=$"
        }
      }
    },
    "appliance_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,3})\\.(0|[1-9][0-9]{0,3})\\.(0|[1-9][0-9]{0,3})$"
    },
    "modules": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{1,40}$"
      },
      "uniqueItems": true
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "index_sha256",
        "files"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999999999
        },
        "index_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "files": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "size_bytes"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 5,
                "maxLength": 200,
                "pattern": "^[a-z][a-zA-Z0-9._+/-]*$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 68719476736
              }
            }
          }
        }
      }
    },
    "testbeds": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "size_bytes",
          "module",
          "version"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 5,
            "maxLength": 200,
            "pattern": "^[a-z][a-zA-Z0-9._+/-]*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 68719476736
          },
          "module": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,40}$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9A-Za-z][0-9A-Za-z.+_-]{0,63}$"
          }
        }
      }
    },
    "feeds": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "size_bytes",
          "id",
          "version",
          "updated_at",
          "details"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 5,
            "maxLength": 200,
            "pattern": "^[a-z][a-zA-Z0-9._+/-]*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 68719476736
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,40}$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9A-Za-z][0-9A-Za-z.+_-]{0,63}$"
          },
          "updated_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
          },
          "details": {
            "type": "object"
          }
        }
      }
    },
    "images": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "size_bytes",
          "module",
          "version",
          "image",
          "digest"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 5,
            "maxLength": 200,
            "pattern": "^[a-z][a-zA-Z0-9._+/-]*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 68719476736
          },
          "module": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,40}$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9A-Za-z][0-9A-Za-z.+_-]{0,63}$"
          },
          "image": {
            "type": "string",
            "minLength": 10,
            "maxLength": 300,
            "pattern": "^[a-z0-9][a-z0-9._/:-]*@sha256:[0-9a-f]{64}$"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
