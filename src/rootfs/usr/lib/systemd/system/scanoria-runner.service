# Service root : tâches d'analyse déposées par scanoria-worker (ARCHITECTURE § 12).
# Il ne fait confiance à rien dans la tâche (principe 4) et lance chaque module
# dans un conteneur jetable confiné (CLAUDE.md § 6.4). File propre, distincte
# de celle du helper : une analyse ne bloque jamais une demande d'administration.
[Unit]
Description=Scanoria scan runner
After=local-fs.target systemd-tmpfiles-setup.service network-online.target scanoria-firewall.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/sbin/scanoria-runner
Restart=on-failure
RestartSec=5
UMask=0027
PrivateTmp=yes
# Durcissement (0.4) compatible avec Podman root : arborescence en lecture
# seule sauf la file d'analyses, le stockage et la configuration réseau de
# Podman et /run (état de Podman, netavark, crun, état du runner). Une seule
# entrée ReadWritePaths par arborescence : deux entrées imbriquées sont deux
# montages, et un rename entre elles échoue en EXDEV (#29). Les cgroups et
# /proc/sys restent inscriptibles : Podman crée les cgroups des conteneurs et
# netavark active le routage de ses réseaux. Pas de ProtectHostname : crun
# donne son propre nom à chaque conteneur (sethostname refusé sinon). b16-live
# lance un conteneur confiné sous ces mêmes réglages.
ProtectSystem=strict
ReadWritePaths=/var/lib/scanoria/scans
ReadWritePaths=/var/lib/containers
ReadWritePaths=/etc/containers/networks
ReadWritePaths=/run
ProtectHome=yes
NoNewPrivileges=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectControlGroups=no
RestrictSUIDSGID=yes
LockPersonality=yes
# Les conteneurs d'analyse en cours sont arrêtés avec le service ; les tâches
# interrompues sont publiées en erreur infra au redémarrage (E_RUNNER_RESTARTED).
KillMode=mixed
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
