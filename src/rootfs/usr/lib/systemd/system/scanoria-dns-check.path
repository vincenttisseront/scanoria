#
# Nouveau nom de l'appliance (set-hostname réécrit appliance.json) : sites des
# modules régénérés et DNS vérifié aussitôt.
[Unit]
Description=Scanoria appliance name watcher (DNS check)

[Path]
PathChanged=/etc/scanoria/appliance.json
Unit=scanoria-dns-check.service

[Install]
WantedBy=multi-user.target
