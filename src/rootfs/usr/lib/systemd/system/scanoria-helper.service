#
# Service root : traite la file des demandes de la console (une à la fois).
[Unit]
Description=Scanoria privileged request helper
After=local-fs.target systemd-tmpfiles-setup.service

[Service]
Type=oneshot
ExecStart=/usr/sbin/scanoria-helper run
# Chaque demande a son propre délai (apply-update et rollback-update : 3300 s,
# retour arrière compris) ; une exécution peut traiter plusieurs demandes à la suite.
TimeoutStartSec=14400
UMask=0027
PrivateTmp=yes
ProtectHome=read-only
KillMode=mixed
