#
# Export périodique d'un lot hors ligne signé (CLAUDE.md § 9, F17) : ne fait
# rien tant qu'un administrateur ne l'a pas activé dans la page « Hors ligne »,
# puis seulement quand l'intervalle choisi (hebdomadaire par défaut) est échu.
[Unit]
Description=Scanoria periodic offline bundle export
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/sbin/scanoria-helper scheduled bundle-export
UMask=0027
PrivateTmp=yes
ProtectHome=read-only
