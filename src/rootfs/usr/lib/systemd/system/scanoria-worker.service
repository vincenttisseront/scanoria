# File d'analyses Scanoria (ARCHITECTURE § 12.1) : processus Node sans
# privilège, même utilisateur et même base que la console. Il dépose les
# tâches de scanoria-runner, ingère les résultats et rend le verdict ; il ne
# lance jamais de conteneur. Démarré, arrêté et redémarré avec la console
# (Wants= de scanoria-console.service, PartOf= ici), donc aussi après une
# mise à jour. SIGTERM : la passe en cours se termine, rien n'est perdu.
[Unit]
Description=Scanoria scan queue worker
After=network.target postgresql.service scanoria-console.service
Wants=postgresql.service
PartOf=scanoria-console.service
ConditionPathExists=/opt/scanoria/current/webui/services/worker.mjs

[Service]
Type=simple
User=scanoria
Group=scanoria
EnvironmentFile=/etc/scanoria/console.env
WorkingDirectory=/opt/scanoria/current/webui
ExecStart=/opt/scanoria/node/bin/node /opt/scanoria/current/webui/services/worker.mjs
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=120
UMask=0077

# Durcissement aligné sur la console : écriture seulement dans la file des
# tâches (jobs/tmp, jobs/incoming) et dans les journaux copiés (console/).
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/scanoria/scans/jobs/tmp /var/lib/scanoria/scans/jobs/incoming
ReadWritePaths=/var/lib/scanoria/console
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
# Le worker ne parle qu'à PostgreSQL (socket local) : aucun accès réseau.
IPAddressAllow=localhost
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
