[Unit]
Description=Scanoria internal certificate renewal (less than 30 days left)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/sbin/scanoria-helper scheduled cert-renew
UMask=0027
PrivateTmp=yes
ProtectHome=read-only
