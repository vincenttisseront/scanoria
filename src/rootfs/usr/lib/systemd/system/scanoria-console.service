# Console web Scanoria (Nuxt/Nitro, Node 22), sans privilège, derrière nginx.
# Les migrations de base passent avant chaque démarrage (migrate.mjs, code 0/1).
[Unit]
Description=Scanoria web console
After=network.target postgresql.service
Wants=postgresql.service
# File d'analyses (0.3) : démarrée avec la console, arrêtée avec elle (PartOf=).
Wants=scanoria-worker.service
ConditionPathExists=/opt/scanoria/current/webui/server/index.mjs

[Service]
Type=simple
User=scanoria
Group=scanoria
EnvironmentFile=/etc/scanoria/console.env
WorkingDirectory=/opt/scanoria/current/webui
ExecStartPre=/opt/scanoria/node/bin/node /opt/scanoria/current/webui/migrate.mjs
ExecStart=/opt/scanoria/node/bin/node /opt/scanoria/current/webui/server/index.mjs
Restart=on-failure
RestartSec=5
TimeoutStartSec=300
UMask=0077

# Durcissement : lecture seule partout sauf les répertoires propres à la console.
# Chaque entrée de ReadWritePaths devient un point de montage distinct : la demande
# est écrite dans requests/tmp puis renommée dans requests/incoming, ce que le noyau
# refuse entre deux montages (EXDEV). On ouvre donc le parent requests/ ; les droits
# Unix (tmpfiles.d) laissent work/, done/ et failed/ hors d'atteinte de la console.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/scanoria/requests
ReadWritePaths=/var/lib/scanoria/uploads /var/lib/scanoria/console /var/lib/scanoria/bootstrap
# Versions figées par projet (0.6, G6) : pins.json écrit par la console.
ReadWritePaths=/var/lib/scanoria/pins
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
# Réseau : la boucle locale (PostgreSQL, nginx) et la sortie vers les API des
# forges (détection F1, découverte, interrogation des commits), qui sont
# HTTPS seulement ; le transport des forges refuse lui-même toute adresse
# résolue de bouclage, de lien local ou de multidiffusion. Les mises à jour
# passent toujours par le helper. Ne pas tout refuser (valeur « any ») :
# la console et le worker ne joindraient plus aucune forge (EPERM).
IPAddressDeny=link-local multicast

[Install]
WantedBy=multi-user.target
