#
# Console web Scanoria (Nuxt/Nitro, Node 22), sans privilège, derrière nginx.
# Les migrations de base passent avant chaque démarrage (migrate.mjs, code 0/1).
[Unit]
Description=Scanoria web console
After=network.target postgresql.service
Wants=postgresql.service
# File d'analyses (0.3) : démarrée avec la console, arrêtée avec elle (PartOf=).
Wants=scanoria-worker.service
ConditionPathExists=/opt/scanoria/current/webui/server/index.mjs

[Service]
Type=simple
User=scanoria
Group=scanoria
EnvironmentFile=/etc/scanoria/console.env
WorkingDirectory=/opt/scanoria/current/webui
ExecStartPre=/opt/scanoria/node/bin/node /opt/scanoria/current/webui/migrate.mjs
ExecStart=/opt/scanoria/node/bin/node /opt/scanoria/current/webui/server/index.mjs
Restart=on-failure
RestartSec=5
TimeoutStartSec=300
UMask=0077

# Durcissement : lecture seule partout sauf les répertoires propres à la console.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/scanoria/requests/tmp /var/lib/scanoria/requests/incoming
ReadWritePaths=/var/lib/scanoria/uploads /var/lib/scanoria/console /var/lib/scanoria/bootstrap
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
# La console n'écoute que sur la boucle locale et ne sort pas sur le réseau
# (les recherches de mises à jour passent par le helper).
IPAddressAllow=localhost
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
