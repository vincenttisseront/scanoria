# scanoria-state : lanceur de l'implémentation Python (bibliothèque standard),
# /usr/lib/scanoria/py/scanoria/state.py. Fonctionne aussi depuis un lot extrait
# (installation initiale : bash <lot>/rootfs/usr/sbin/scanoria-state …).
set -euo pipefail
here=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
exec /usr/bin/python3 -I -B "$here/../lib/scanoria/py/run.py" state "$@"
