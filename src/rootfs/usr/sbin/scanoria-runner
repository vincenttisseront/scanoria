# scanoria-runner : exécute les tâches d'analyse en root (ARCHITECTURE § 12) ;
# lanceur de /usr/lib/scanoria/py/scanoria/runner.py (bibliothèque standard).
set -euo pipefail
here=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
exec /usr/bin/python3 -I -B "$here/../lib/scanoria/py/run.py" runner "$@"
