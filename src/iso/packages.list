# Paquets installés par l'ISO depuis son dépôt local (hors ligne). build.sh
# télécharge ces paquets et toutes leurs dépendances (vérifiées par apt) dans
# /scanoria/pool de l'ISO. Un nom par ligne.
postgresql-16
postgresql-client-16
nginx
podman
# Résolution des noms entre conteneurs d'un même réseau (modules « service » et
# leurs scanners, ex. dtrack-upload → Dependency-Track) : simple recommandation
# de podman, donc absente avec --no-install-recommends.
netavark
aardvark-dns
skopeo
uidmap
slirp4netns
catatonit
nftables
jq
zstd
openssl
curl
ca-certificates
python3
whiptail
console-setup
kbd
tzdata
locales
