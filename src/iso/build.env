#
# Paramètres de construction communs à build.sh et make-iso.ps1.
#
# Image du conteneur de construction (toujours un conteneur neuf, --pull=always),
# épinglée par empreinte (index multi-architecture de ubuntu:24.04, relevé le
# 2026-11-23 et concordant sur mirror.gcr.io et public.ecr.aws). Mise à jour à
# la main, dans une PR, en relevant la nouvelle empreinte.
BUILD_IMAGE=docker.io/library/ubuntu:24.04@sha256:9c7f200c07e3d4a03e7249d2c16bf66a51120fb876aa2242cf31451412543289
# Plus ancienne version de l'appliance qui peut passer directement à celle-ci
# (release.json, champ min_upgrade_from).
MIN_UPGRADE_FROM=0.1.0
# Empreinte SHA-256 (DER SubjectPublicKeyInfo) de update-pubkey.pem : la
# construction échoue si la clé versionnée ne correspond pas.
UPDATE_PUBKEY_SHA256=696af1d4c9cfb71c47e9940e6d80d69a8074786967fc1e7e857f5865a3b1f803
