#
# ISO de base de l'appliance : version épinglée. Changer de version = modifier
# ce fichier (nom, empreinte) dans une PR ; build.sh vérifie la signature GPG de
# SHA256SUMS (clé keys/ubuntu-cdimage-2012.asc, empreinte ci-dessous), puis que
# la ligne de l'ISO dans SHA256SUMS ET le fichier téléchargé correspondent à
# UBUNTU_ISO_SHA256. Valeurs relevées sur le miroir officiel le 2026-11-23.
UBUNTU_ISO_VERSION=24.04.5
UBUNTU_ISO_NAME=ubuntu-24.04.5-live-server-amd64.iso
UBUNTU_ISO_BASE_URL=https://releases.ubuntu.com/24.04.5
UBUNTU_ISO_SHA256=97f3d7ffb032c3eb3b23d2c8be9cc76e60c2c1f2c0146ba5ba9fe01cafae0fd8
UBUNTU_ISO_SIZE=4080486400
UBUNTU_GPG_KEY_FILE=keys/ubuntu-cdimage-2012.asc
UBUNTU_GPG_FPR=843938DF228D22F7B3742BC0D94AA3F0EFE21092
