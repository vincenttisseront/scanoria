{
 "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
 "version": "2.1.0",
 "runs": [
  {
   "tool": {
    "driver": {
     "name": "SonarQube",
     "informationUri": "https://www.sonarsource.com/products/sonarqube/",
     "rules": [
      {
       "id": "python:S1192",
       "name": "String literals should not be duplicated",
       "shortDescription": {
        "text": "String literals should not be duplicated"
       },
       "properties": {
        "tags": [
         "design"
        ]
       }
      },
      {
       "id": "python:S1481",
       "name": "Unused local variables should be removed",
       "shortDescription": {
        "text": "Unused local variables should be removed"
       },
       "properties": {
        "tags": [
         "unused"
        ]
       }
      },
      {
       "id": "python:S2068",
       "name": "Hard-coded passwords are security-sensitive",
       "shortDescription": {
        "text": "Hard-coded passwords are security-sensitive"
       },
       "properties": {
        "tags": [
         "security-hotspot",
         "auth"
        ]
       }
      },
      {
       "id": "python:S2077",
       "name": "Formatting SQL queries is security-sensitive",
       "shortDescription": {
        "text": "Formatting SQL queries is security-sensitive"
       },
       "properties": {
        "tags": [
         "security-hotspot",
         "sql-injection"
        ]
       }
      }
     ],
     "version": "26.11.0.134175"
    }
   },
   "results": [
    {
     "ruleId": "python:S1481",
     "level": "note",
     "message": {
      "text": "Remove the unused local variable \"unused\"."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "app/db.py"
        },
        "region": {
         "startLine": 10,
         "endLine": 10,
         "startColumn": 5,
         "endColumn": 11
        }
       }
      }
     ],
     "properties": {
      "severity": "low",
      "tags": [
       "unused",
       "scanoria-category:quality"
      ],
      "sonarKind": "CODE_SMELL"
     },
     "partialFingerprints": {
      "sonarqube/key/v1": "issue-0001"
     }
    },
    {
     "ruleId": "python:S1192",
     "level": "error",
