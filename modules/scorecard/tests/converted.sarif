{
 "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
 "runs": [
  {
   "properties": {
    "scanoria": {
     "checks": {
      "Binary-Artifacts": 9,
      "Dangerous-Workflow": 0,
      "License": 10,
      "Pinned-Dependencies": -1,
      "Token-Permissions": 0
     },
     "mode": "local",
     "score": 3.2,
     "threshold": 4.0,
     "wrapper": "sast_run",
     "wrapper_version": "1.0.0"
    }
   },
   "results": [
    {
     "level": "error",
     "message": {
      "text": "OpenSSF Scorecard aggregate score 3.2/10 is below the threshold 4.0 (local checks only)."
     },
     "partialFingerprints": {
      "scorecardCheck/v1": "aggregate"
     },
     "properties": {
      "score": 3.2,
      "severity": "high",
      "threshold": 4.0
     },
     "ruleId": "scorecard/score-below-threshold",
     "ruleIndex": 0
    },
    {
     "level": "note",
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": ".github/workflows/triage.yml"
        },
        "region": {
         "startLine": 8
        }
       }
      }
     ],
     "message": {
      "text": "Token-Permissions: 0/10. detected GitHub workflow tokens with excessive permissions"
     },
     "partialFingerprints": {
      "scorecardCheck/v1": "Token-Permissions"
     },
     "properties": {
      "details": [
       "Warn: topLevel 'write-all' permission set: .github/workflows/triage.yml:8"
      ],
      "score": 0,
      "severity": "low"
     },
     "ruleId": "scorecard/Token-Permissions",
     "ruleIndex": 1
    },
    {
     "level": "warning",
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": ".github/workflows/triage.yml"
        },
        "region": {
         "startLine": 15
        }
       }
      }
     ],
     "message": {
      "text": "Dangerous-Workflow: 0/10. dangerous workflow patterns detected"
     },
     "partialFingerprints": {
      "scorecardCheck/v1": "Dangerous-Workflow"
     },
     "properties": {
      "details": [
       "Warn: untrusted code checkout: .github/workflows/triage.yml:15"
      ],
      "score": 0,
      "severity": "medium"
     },
     "ruleId": "scorecard/Dangerous-Workflow",
     "ruleIndex": 2
    },
    {
     "level": "note",
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "tools/helper.jar"
        },
        "region": {
         "startLine": 1
        }
       }
      }
     ],
     "message": {
      "text": "Binary-Artifacts: 9/10. binaries present in source code"
     },
     "partialFingerprints": {
      "scorecardCheck/v1": "Binary-Artifacts"
     },
     "properties": {
      "details": [
       "Warn: binary detected: tools/helper.jar:1"
      ],
      "score": 9,
      "severity": "low"
     },
     "ruleId": "scorecard/Binary-Artifacts",
     "ruleIndex": 3
    }
   ],
   "tool": {
    "driver": {
     "informationUri": "https://github.com/ossf/scorecard",
     "name": "OpenSSF Scorecard",
     "rules": [
      {
       "helpUri": "https://github.com/ossf/scorecard/blob/main/docs/checks.md",
       "id": "scorecard/score-below-threshold",
       "name": "ScoreBelowThreshold",
       "properties": {
        "tags": [
         "supply-chain",
         "posture"
        ]
       },
       "shortDescription": {
        "text": "OpenSSF Scorecard: aggregate score below the appliance threshold"
       }
      },
      {
       "helpUri": "https://github.com/ossf/scorecard/blob/main/docs/checks.md#token-permissions",
       "id": "scorecard/Token-Permissions",
       "name": "TokenPermissions",
       "properties": {
        "tags": [
         "supply-chain",
         "posture"
        ]
       },
       "shortDescription": {
        "text": "Determines if the project's workflows follow the principle of least privilege."
       }
      },
      {
       "helpUri": "https://github.com/ossf/scorecard/blob/main/docs/checks.md#dangerous-workflow",
       "id": "scorecard/Dangerous-Workflow",
       "name": "DangerousWorkflow",
       "properties": {
        "tags": [
         "supply-chain",
         "posture"
        ]
       },
       "shortDescription": {
        "text": "Determines if the project's GitHub Action workflows avoid dangerous patterns."
       }
      },
      {
       "helpUri": "https://github.com/ossf/scorecard/blob/main/docs/checks.md#binary-artifacts",
       "id": "scorecard/Binary-Artifacts",
       "name": "BinaryArtifacts",
       "properties": {
        "tags": [
         "supply-chain",
         "posture"
        ]
       },
       "shortDescription": {
        "text": "Determines if the project has generated executable (binary) artifacts in the source repository."
       }
      }
     ],
     "version": "v5.7.0"
    }
   }
  }
 ],
 "version": "2.1.0"
}
