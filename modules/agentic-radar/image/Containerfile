# Image du module agentic-radar (K7, 0.7) : Agentic Radar 0.14.2 de SPLX
# (Apache-2.0), installé depuis PyPI par pip --require-hashes à partir du
# verrou complet requirements.lock (uv pip compile --generate-hashes, Python
# 3.13, linux x86_64), sur l'image officielle python 3.13-slim épinglée par
# empreinte. L'amont ne publie aucune image de conteneur (docs/MODULES.md § 8).
ARG SOURCE_DATE_EPOCH=0
FROM docker.io/library/python@sha256:7249d5587b78209a006dc4a3b5340678f84ea729239193aa559962cd8c1fce50
ENV PYTHONDONTWRITEBYTECODE=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1
COPY requirements.lock /tmp/requirements.lock
RUN pip install --require-hashes --no-deps --only-binary=:all: -r /tmp/requirements.lock \
 && rm -f /tmp/requirements.lock
LABEL org.opencontainers.image.source="https://github.com/splx-ai/agentic-radar" \
      org.opencontainers.image.revision="4bad7ffe9a9f96bed6a7f625ef516a632068f2ae" \
      org.opencontainers.image.version="0.14.2" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.description="Agentic Radar pour Scanoria (analyse statique, aucun appel de modèle)" \
      io.scanoria.module="agentic-radar"
USER 65534:65534
