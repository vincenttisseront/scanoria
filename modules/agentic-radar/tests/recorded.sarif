{"$schema": "https://json.schemastore.org/sarif-2.1.0.json", "version": "2.1.0", "runs": [{"tool": {"driver": {"name": "agentic-radar", "version": "0.14.2", "informationUri": "https://github.com/splx-ai/agentic-radar", "rules": [{"id": "agentic-radar/arbitrary-code-execution-ace", "name": "Arbitrary Code Execution (ACE)", "shortDescription": {"text": "Arbitrary Code Execution (ACE)"}, "fullDescription": {"text": "Tool lets the agent execute Python code, which can be exploited to run unauthorized commands. If an attacker influences the prompt (directly or via the LLM), they could inject harmful Python code (e.g. calling OS commands via os.system or using exec). This effectively gives remote code execution on the host. Without sandboxing, the agent could read/write files or escalate privileges on the system."}, "help": {"text": "\u2022 Restrict AI code generation permissions\n\u2022 Implement sandbox environment where code execution is limited\n\u2022 Implement execution control policies that flag AI generated code with elevated privileges for manual review"}, "properties": {"tags": ["agentic", "llm", "CVEs: CVE-2023-36258\nCVE-2023-44467", "OWASP Agentic: T11 - Unexpected RCE and Code Attacks", "OWASP LLM Top 10: LLM05 - Improper Output Handling\nLLM06 - Excessive Agency"]}}]}}, "originalUriBaseIds": {"SRCROOT": {"uri": "file:///src/"}}, "results": [{"ruleId": "agentic-radar/arbitrary-code-execution-ace", "level": "error", "message": {"text": "Tool \"Shell (bash)\" (code_interpreter) of the langgraph workflow \"lg\": Arbitrary Code Execution (ACE)"}, "partialFingerprints": {"agenticRadar/v1": "25d2b2f994ca62744166e7999cf7ef63b765c97dc0d2d3f9030b6e70e363f665"}, "properties": {"framework": "langgraph", "workflow": "lg", "tool": "Shell (bash)", "toolCategory": "code_interpreter", "toolType": "tool"}}], "properties": {"scanoria/agent-inventory": {"version": 1, "tool_version": "0.14.2", "frameworks": ["langgraph"], "workflows": [{"framework": "langgraph", "name": "lg", "nodes": [{"name": "agent", "type": "basic", "category": null, "description": null, "vulnerabilities": []}, {"name": "tools", "type": "basic", "category": null, "description": null, "vulnerabilities": []}, {"name": "START", "type": "basic", "category": null, "description": null, "vulnerabilities": []}, {"name": "END", "type": "basic", "category": null, "description": null, "vulnerabilities": []}], "edges": [{"start": "agent", "end": "tools", "condition": null}, {"start": "tools", "end": "END", "condition": null}, {"start": "START", "end": "agent", "condition": null}], "agents": [], "tools": [{"name": "Shell (bash)", "type": "tool", "category": "code_interpreter", "description": null, "vulnerabilities": ["Arbitrary Code Execution (ACE)"]}, {"name": "lookup", "type": "custom_tool", "category": "default", "description": "Look up a customer.", "vulnerabilities": []}], "mcp_servers": []}], "errors": [], "truncated": false}}}]}