     "rules": [
      {
       "id": "reach-index/import",
       "shortDescription": {
        "text": "Module imported by the code"
       },
       "defaultConfiguration": {
        "level": "none"
       }
      },
      {
       "id": "reach-index/call",
       "shortDescription": {
        "text": "Call through an imported module"
       },
       "defaultConfiguration": {
        "level": "none"
       }
      }
     ]
    }
   },
