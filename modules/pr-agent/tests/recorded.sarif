{
 "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
 "version": "2.1.0",
 "runs": [
  {
   "tool": {
    "driver": {
     "name": "pr-agent",
     "version": "1.0.0",
     "informationUri": "https://github.com/the-pr-agent/pr-agent",
     "rules": [
      {
       "id": "pr-agent/key-issue",
       "shortDescription": {
        "text": "Point à revoir dans la PR (PR-Agent)"
       },
       "properties": {
        "severity": "medium",
        "tags": [
         "ai"
        ]
       }
      },
      {
       "id": "pr-agent/security-concern",
       "shortDescription": {
        "text": "Préoccupation de sécurité dans la PR (PR-Agent)"
       },
       "properties": {
        "severity": "high",
        "tags": [
         "ai"
        ]
       }
      }
     ]
    }
   },
   "results": [
    {
     "ruleId": "pr-agent/key-issue",
     "level": "warning",
     "message": {
      "text": "Injection SQL : La requête concatène l'entrée utilisateur."
     },
     "properties": {
      "severity": "medium",
      "tags": [
       "ai",
       "review"
      ]
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "app.py"
        },
        "region": {
         "startLine": 5,
         "endLine": 6
        }
       }
      }
     ]
    },
    {
     "ruleId": "pr-agent/security-concern",
     "level": "error",
     "message": {
      "text": "SQL injection: user input concatenated into a query."
     },
     "properties": {
      "severity": "high",
      "tags": [
       "ai",
       "security"
      ]
     }
    }
   ],
   "properties": {
    "scanoria/pr-agent": {
     "version": "1.0.0",
     "effort": 2,
     "score": 70,
     "files_not_reviewed": [],
     "description": {
      "title": "Recherche d'utilisateur",
      "type": "Enhancement",
      "description": "- Ajoute une recherche d'utilisateur"
     }
    }
   }
  }
 ]
}