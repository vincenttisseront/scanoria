# Image du module mcp-scanner-llm (K5, 0.7) : même recette que mcp-scanner
# (Cisco AI MCP Scanner 4.8.7, Apache-2.0), publiée sous son propre nom. Le
# module n'utilise que l'analyseur LLM de l'amont, relié au relais de
# scanoria-ai ; jamais l'API Cisco ni VirusTotal (docs/MODULES.md § 8 et § 9).
ARG SOURCE_DATE_EPOCH=0
FROM docker.io/library/python@sha256:7249d5587b78209a006dc4a3b5340678f84ea729239193aa559962cd8c1fce50
ENV PYTHONDONTWRITEBYTECODE=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1
COPY requirements.lock /tmp/requirements.lock
RUN pip install --require-hashes --no-deps --only-binary=:all: -r /tmp/requirements.lock \
 && rm -f /tmp/requirements.lock
LABEL org.opencontainers.image.source="https://github.com/cisco-ai-defense/mcp-scanner" \
      org.opencontainers.image.revision="b27af3b0e66ea8d5ab9c294b47aba137f4c30752" \
      org.opencontainers.image.version="4.8.7" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.description="Cisco AI MCP Scanner pour Scanoria (juge LLM par le relais de l'appliance seulement)" \
      io.scanoria.module="mcp-scanner-llm"
USER 65534:65534
