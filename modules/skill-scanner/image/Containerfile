# Image du module skill-scanner (K6, 0.7) : Cisco AI Skill Scanner 2.3.2
# (Apache-2.0), installé depuis PyPI par pip --require-hashes à partir du
# verrou complet requirements.lock (uv pip compile --generate-hashes
# --only-binary :all:, Python 3.13, linux x86_64), sur l'image officielle
# python 3.13-slim épinglée par empreinte. Seuls les analyseurs hors ligne sont
# utilisés par le module (aucun appel à OSV.dev, à l'API Cisco, à VirusTotal ni à un
# LLM) ; l'amont ne publie aucune image de conteneur (docs/MODULES.md § 8).
ARG SOURCE_DATE_EPOCH=0
FROM docker.io/library/python@sha256:7249d5587b78209a006dc4a3b5340678f84ea729239193aa559962cd8c1fce50
ENV PYTHONDONTWRITEBYTECODE=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1
COPY requirements.lock /tmp/requirements.lock
RUN pip install --require-hashes --no-deps --only-binary=:all: -r /tmp/requirements.lock \
 && rm -f /tmp/requirements.lock
LABEL org.opencontainers.image.source="https://github.com/cisco-ai-defense/skill-scanner" \
      org.opencontainers.image.revision="f7824651ffeb9b89f7682ddd97d6fba8fe9c10b1" \
      org.opencontainers.image.version="2.3.2" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.description="Cisco AI Skill Scanner pour Scanoria (analyse statique et YARA-X hors ligne)" \
      io.scanoria.module="skill-scanner"
USER 65534:65534
